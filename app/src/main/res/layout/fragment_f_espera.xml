<?xml version="1.0" encoding="utf-8"?>
<layout>
    <androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/fons_fragment"
        android:padding="24dp"
        tools:context=".A3_Partida.F_Espera">

        <TextView
            android:id="@+id/tvTitolEspera"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SALA D'ESPERA"
            android:textColor="@android:color/white"
            android:textSize="30sp"
            android:textStyle="bold"
            android:layout_marginTop="40dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/tvCodiSala"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Codi: --"
            android:textColor="@color/header_background"
            android:textSize="18sp"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/tvTitolEspera"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/tvTitolJugadors"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Jugadors a la sala:"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            android:layout_marginStart="0dp"
            app:layout_constraintTop_toBottomOf="@id/tvCodiSala"
            app:layout_constraintStart_toStartOf="parent"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvJugadorsEspera"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/tvTitolJugadors"
            app:layout_constraintBottom_toTopOf="@id/layoutEquips"
            app:layout_constraintVertical_bias="0"/>

        <LinearLayout
            android:id="@+id/layoutEquips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/rvJugadorsEspera"
            app:layout_constraintBottom_toTopOf="@id/pbCarregant">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Equips:"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvEquips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:layout_marginTop="4dp"/>

        </LinearLayout>

        <ProgressBar
            android:id="@+id/pbCarregant"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:layout_constraintBottom_toTopOf="@id/tvEsperant"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/tvEsperant"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Esperant que l'admin iniciï la partida..."
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:layout_marginBottom="32dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>